{
  "name": "youtube-ai-translator",
  "description": "Translate existing YouTube captions into synchronized bilingual subtitles.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:development": "node scripts/build-channel.mjs development",
    "build:beta": "node scripts/build-channel.mjs beta",
    "build:stable": "node scripts/build-channel.mjs stable",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "package:beta": "node scripts/package-extension.mjs beta",
    "package:stable": "node scripts/package-extension.mjs stable",
    "verify:release": "node scripts/verify-release-package.mjs",
    "verify:features": "node scripts/verify-feature-flags.mjs",
    "verify:permissions": "node scripts/verify-store-permissions.mjs",
    "release:report": "node scripts/generate-release-report.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit tests/app tests/captions tests/translation tests/rendering tests/cache tests/export tests/security tests/popup",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:race": "vitest run tests/race",
    "test:security": "vitest run tests/security",
    "test:performance": "vitest run tests/observability",
    "test:validate": "npm run compile && npm run test:unit && npm run test:contracts && npm run test:security && npm run test:race",
    "test:ci": "npm run test:validate && npm run build",
    "performance:smoke": "node scripts/run-performance-suite.mjs",
    "performance:compare": "node scripts/compare-performance-baseline.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1",
    "wxt": "^0.19.28"
  }
}
